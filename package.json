{
  "name": "greenhouse-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration && npm run test:firmware && npm run test:migration",
    "test:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/unit/*.test.ts",
    "test:integration": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/integration/*.test.ts",
    "test:firmware": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/firmware/*.test.ts",
    "test:migration": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/migration/*.test.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "@types/nodemailer": "^7.0.12",
    "next": "16.2.6",
    "nodemailer": "^7.0.13",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
